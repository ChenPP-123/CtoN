{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/v1/internal/scheduled-update/morning",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/v1/internal/scheduled-update/afternoon",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/internal/scheduled-update/evening",
      "schedule": "0 13 * * *"
    }
  ]
}
