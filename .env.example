APP_ENV=development
APP_TIMEZONE=Asia/Shanghai

# 运行时使用池化地址；本地开发可直接使用本机 PostgreSQL。
DATABASE_URL=postgresql://localhost/cton
# 仅在本地执行 `python -m backend.database` 时使用，不配置到 Vercel。
DATABASE_MIGRATION_URL=postgresql://localhost/cton
# 测试清理只接受数据库名以 _test 结尾的地址。
TEST_DATABASE_URL=postgresql://localhost/cton_test

CORS_ORIGINS=http://localhost:5173
ADMIN_API_TOKEN=
CRON_SECRET=

QWEATHER_API_KEY=
QWEATHER_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Web Service Key 仅供可选维护脚本使用；运行时高德代理只需要安全密钥。
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_JS_CODE=
